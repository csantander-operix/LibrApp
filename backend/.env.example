# App
APP_NAME=LibrApp
ENV=development
DEBUG=true

# CORS: en dev "*"; en prod la(s) URL(s) del frontend separadas por coma.
CORS_ORIGINS=*

# Base de datos
DATABASE_URL=postgresql://librapp:librapp@db:5432/librapp_db

# JWT
JWT_SECRET_KEY=changeme-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seed del usuario administrador inicial (se crea idempotente en dev).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!

# Corre el seed (admin + datos demo) al arrancar. En dev ya corre por ENV=development.
RUN_SEED_ON_STARTUP=false
